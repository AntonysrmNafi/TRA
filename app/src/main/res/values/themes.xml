<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TrackerRemover" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bv_purple</item>
        <item name="colorPrimaryDark">@color/bv_purple_dark</item>
        <item name="colorAccent">@color/bv_purple</item>
        <item name="android:windowBackground">@color/bv_bg</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Matches the toolbar's own background color exactly, rather than
             the default colorPrimaryDark, so the status bar and toolbar
             read as one seamless purple bar instead of two visibly
             different shades stacked on top of each other. -->
        <item name="android:statusBarColor">@color/black</item>
    </style>

    <!-- Used by ShareCleanActivity: a fully invisible window (no dim, no
         animation, nothing drawn) so selecting this app from another app's
         Share sheet never visibly looks like switching apps. Status/nav bar
         colors are explicitly transparent too — without this, the status
         bar picks up colorPrimary from the parent theme and shows as a
         visible colored strip even though everything else is invisible. -->
    <style name="Theme.TrackerRemover.Transparent" parent="Theme.TrackerRemover">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Settings > Other grid tile styles: icon-over-label tappable tile. -->
    <style name="OtherGridTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/bg_tile_neutral</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="OtherGridTileIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
    </style>

    <style name="OtherGridTileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/bv_text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
