<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".TrackerRemoverApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrackerRemover">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Share-sheet target: cleans the link and immediately
             re-opens the Share sheet with the result. See ShareCleanActivity
             for why this is a separate, near-invisible activity rather than
             part of MainActivity.

             taskAffinity is deliberately its own distinct string (not the
             app's default): without this, if MainActivity was already
             running in the background from an earlier session, Android
             would reuse that same task for this activity too — bringing
             the whole task, MainActivity included, to the foreground
             instead of staying invisible. -->
        <activity
            android:name=".ui.ShareCleanActivity"
            android:exported="true"
            android:theme="@style/Theme.TrackerRemover.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.blockveil.tracker.remover.sharetask">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:label="@string/history_title" />

        <activity
            android:name=".ui.HistoryDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.TextDocumentActivity"
            android:exported="false" />

    </application>
</manifest>
